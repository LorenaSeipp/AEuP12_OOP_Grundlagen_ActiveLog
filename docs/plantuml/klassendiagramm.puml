
@startuml 
!include style.puml

interface ISensor <<interface>> {
+LiesMesswert(): string
}
abstract class Uebung <<abstract>>
{
- _intensitaet : int
+ Name: string {readOnly}
+ IstAktiv: bool {readOnly}
+ Intensitaet : int {0..100}
+ Uebung(name : string)
+ Uebung(name : string, intensitaet : int)
+ Aktivieren() : void
+ Deaktivieren(): void
+ Statuszeile() : string {virtual}
}

class Kraftuebung {
+ Kraftuebung(name: string) 
+ Kraftuebung(name : string, intensitaet : int) 
+ Statuszeile() : string  {override}
}

class Laufeinheit {
- _zielpuls : int {90.. 180}
+ Zielpuls : int
+ Laufeinheit(name: string) 
+ Laufeinheit(name : string, zielpuls: int) 
+ Statuszeile() : string  {override}
+LiesMesswert(): string 
+MessePuls(schlaege : int): void
}

class Schwimmeinheit {
- _anzahlBahnen : int 
+ AnzahlBahnen : int
+ Schwimmeinheit(name: string) 
+ Statuszeile() : string  {override}
+LiesMesswert(): string 
+MeldeBahnen(): void
}

class Mobilityuebung {
- _startZeit : DateTime 
+SollDauerInSek : int {readOnly}
+IstDauerInSek : int {readOnly}
+ZeitTrackingLaeuft : bool 
+Mobilityuebung(name:string) 
+Mobilityuebung(name : string, sollDauerInSek : int) 
+Statuszeile() : string  {override}
+StarteZeitTracking() : void
+StoppeZeitTracking() : void
-AktuelleTrainingsZeitInSek() : int
+LiesMesswert(): string 
}

Uebung <|-- Kraftuebung 
Uebung <|-- Mobilityuebung 
Uebung <|-- Laufeinheit 
Uebung <|-- Schwimmeinheit
ISensor <|.. Laufeinheit 
ISensor <|.. Mobilityuebung
ISensor <|.. Schwimmeinheit


@enduml